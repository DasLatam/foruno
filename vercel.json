{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/sessions/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(telemetria|guiones)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(index|temporadas)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, s-maxage=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 30
    }
  },
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/ver/:key(\\d+)",
      "destination": "/"
    },
    {
      "source": "/gp/:key(\\d+)",
      "destination": "/"
    }
  ]
}
