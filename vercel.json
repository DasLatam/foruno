{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "https://hiox.com.ar/foruno/", "permanent": true },
    { "source": "/((?!api/).*)", "destination": "https://hiox.com.ar/foruno/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
